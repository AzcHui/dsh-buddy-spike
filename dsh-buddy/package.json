{
  "name": "dsh-buddy",
  "version": "1.1.0",
  "description": "Heart-transplant plugin for dsh (DeepSeek Harness): replace the stock agent-loop with CodeBuddy CLI as the single brain, with a bundled remote-control settings panel. Powered by @tencent-ai/agent-sdk — Tencent plan quota only, zero DeepSeek tokens.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./llm": "./lib/llm.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzcHui/dsh-buddy-spike.git",
    "directory": "dsh-buddy"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.264"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.4",
    "@deepseek-ai/dsh-llm": ">=0.1.4",
    "@deepseek-ai/dsh-scope": ">=0.1.4",
    "@deepseek-ai/dsh-session": ">=0.1.4",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
